# Production origin including https://; localhost is the development default.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Use /repository-name for a GitHub Pages project site; otherwise leave empty.
NEXT_PUBLIC_BASE_PATH=

# Optional visitor map configuration (public browser credentials only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional credentials for the citation refresh script.
OPENALEX_API_KEY=
OPENALEX_EMAIL=
